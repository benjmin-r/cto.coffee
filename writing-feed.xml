---
layout: null
permalink: /writing-feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd" xml:lang="{{ site.lang }}">
  <channel>
    <atom:link href="{{ site.url }}/writing-feed.xml" rel="self" type="application/rss+xml" />
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}</link>
    <language>{{ site.lang }}</language>
    <managingEditor>{{ site.email }} ({{ site.author }})</managingEditor>
    <webMaster>{{ site.email }} ({{ site.author }})</webMaster>
    <copyright>{{ site.copyright }}</copyright>
    <pubDate>{{ "now" | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ "now" | date_to_rfc822 }}</lastBuildDate>
    <image>
      <link>{{ site.url }}</link>
      <url>{{ site.url }}/static/img/itunes.png</url>
      <title>{{ site.title | xml_escape }}</title>
    </image>
    {% for post in collections.writing limit:10 %}
      <item>
        <title>{{ post.data.title | xml_escape }}</title>
        <link>{{ site.url }}{{ post.url | pretty_url }}</link>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <description>{{ post.templateContent | xml_escape }}</description>
        <guid isPermaLink="true">{{ site.url }}{{ post.url | pretty_url }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
